<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121212">

    <!-- Judul -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Profile"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Profile -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:background="#6C5CE7">

        <ImageView
            android:id="@+id/ivProfile"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="Profile Photo" />

        <TextView
            android:id="@+id/tvNama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sarah Johnson"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvJabatan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Administrator"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Account Information -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Account Information"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp" />

    <!-- Email -->
    <TextView
        android:id="@+id/tvEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email\nsarah@school.edu"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:padding="15dp"
        android:background="#262626"
        android:clickable="true"
        android:focusable="true" />

    <!-- Phone -->
    <TextView
        android:id="@+id/tvPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Phone\n+1 (555) 987-6547"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:padding="15dp"
        android:layout_marginTop="8dp"
        android:background="#262626"
        android:clickable="true"
        android:focusable="true" />

    <!-- Institution -->
    <TextView
        android:id="@+id/tvInstitution"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Institution\nUniversity of Oxford"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:padding="15dp"
        android:layout_marginTop="8dp"
        android:background="#262626" />

    <!-- Role -->
    <TextView
        android:id="@+id/tvRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Role\nAdmin"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:padding="15dp"
        android:layout_marginTop="8dp"
        android:background="#262626"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>